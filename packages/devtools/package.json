{
  "name": "@morpha/devtools",
  "version": "0.0.0",
  "private": true,
  "description": "Presentation Engine — devtools (Ring 3). Placeholder; see docs/architecture/packages/Package-Structure.md.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@morpha/runtime": "workspace:*",
    "@morpha/events": "workspace:*",
    "@morpha/commands": "workspace:*",
    "@morpha/plugin-api": "workspace:*"
  }
}
