{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"],
      "inputs": [
        "src/**",
        "tsdown.config.ts",
        "vite.config.ts",
        "astro.config.mjs",
        "index.html",
        "package.json",
        "tsconfig.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": { "cache": false }
  }
}
